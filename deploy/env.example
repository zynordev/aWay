# aWay sinyal sunucusu ortam değişkenleri — /etc/away/env olarak kopyala ve düzenle.

# Sunucunun dinleyeceği yerel adres (nginx önünde TLS sonlandırır).
AWAY_BIND=127.0.0.1:9000

# Hesap dosyası (argon2 hash'li). systemd ReadWritePaths ile uyumlu olmalı.
AWAY_ACCOUNTS=/var/lib/away/accounts.json

# Açık kaydı KAPALI tut (hesaplar `away-server adduser` ile açılır). Açmak için 1 yap.
AWAY_ALLOW_REGISTER=0

# ── STUN / TURN (coturn) ─────────────────────────────────────────────────────
# turnserver.conf içindeki static-auth-secret ile AYNI olmalı.
AWAY_TURN_SECRET=161b82fc050b7d5462b3b58e3eb3df9d7f83aeca12c8913e03241fff65192426
# Alt alan adını kendi domaininle değiştir:
AWAY_STUN_URLS=stun:away.bilgicoderteam.tr:3478
AWAY_TURN_URLS=turn:away.bilgicoderteam.tr:3478?transport=udp,turn:away.bilgicoderteam.tr:3478?transport=tcp
# Üretilen geçici TURN kimlik bilgisi ömrü (saniye)
AWAY_TURN_TTL=600

# Log seviyesi
RUST_LOG=info,away_server=info
